<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FocasProbe</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- 自动带上 FANUC FWLIB 原生库（与 Host 用的是同一份 native 目录） -->
  <ItemGroup>
    <None Include="..\..\Host\src\IndustrialIoT.Protocols.FANUC\native\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
